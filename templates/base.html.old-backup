<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>{% block title %}{{ STORE_NAME }} — Online Shopping{% endblock %}</title>
  <!-- Bootstrap 5 — CDN (internet-la irundhu load aagum) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/sk.css') }}">
</head>
<body>

<!-- ── top strip ─────────────────────────────────────────────── -->
<div class="topstrip">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span>🚚 Free delivery above <strong>{{ FREE_SHIPPING_ABOVE | money }}</strong> &nbsp;|&nbsp; 7-day easy returns &nbsp;|&nbsp; COD available</span>
    <span>
      {% if current_user.is_authenticated %}
        Hi, <strong>{{ current_user.name.split()[0] }}</strong>
        <span class="divider-dot"></span><a href="{{ url_for('orders.history') }}">My Orders</a>
        {% if current_user.is_admin %}<span class="divider-dot"></span><a href="{{ url_for('admin.dashboard') }}">Admin Panel</a>{% endif %}
      {% else %}
        <a href="{{ url_for('auth.login') }}">Login</a> <span class="divider-dot"></span>
        <a href="{{ url_for('auth.signup') }}">New? Sign up</a>
      {% endif %}
    </span>
  </div>
</div>

<!-- ── header ────────────────────────────────────────────────── -->
<header class="sk-header py-3">
  <div class="container">
    <div class="row g-3 align-items-center">
      <div class="col-6 col-lg-2">
        <a href="{{ url_for('main.home') }}" class="brand-logo">{{ STORE_NAME[:4] }}<span>{{ STORE_NAME[4:] }}</span>
          <small>MARKETPLACE</small></a>
      </div>

      <div class="col-12 col-lg-6 order-lg-2 order-3">
        <form class="sk-search" action="{{ url_for('main.products') }}" method="get">
          <input type="text" name="q" placeholder="Search products, brands and sellers..."
                 value="{{ request.args.get('q', '') }}" aria-label="Search products">
          <button type="submit" aria-label="Search"><i class="bi bi-search"></i></button>
        </form>
      </div>

      <div class="col-6 col-lg-4 order-lg-3 text-end">
        <div class="d-inline-flex align-items-center gap-3 gap-lg-4">
          <a href="{{ url_for('main.wishlist') }}" class="hdr-link d-none d-sm-block">
            <i class="bi bi-heart fs-5 d-block"></i>Wishlist
          </a>

          {% if current_user.is_authenticated %}
            <div class="dropdown">
              <a href="#" class="hdr-link dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle fs-5 d-block"></i>Hello, {{ current_user.name.split()[0] }}
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><a class="dropdown-item" href="{{ url_for('auth.account') }}"><i class="bi bi-person"></i> My Account</a></li>
                <li><a class="dropdown-item" href="{{ url_for('orders.history') }}"><i class="bi bi-box-seam"></i> My Orders</a></li>
                <li><a class="dropdown-item" href="{{ url_for('auth.addresses') }}"><i class="bi bi-geo-alt"></i> Addresses</a></li>
                {% if current_user.is_admin %}
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-brand" href="{{ url_for('admin.dashboard') }}"><i class="bi bi-speedometer2"></i> Admin Dashboard</a></li>
                {% endif %}
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="{{ url_for('auth.logout') }}"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
              </ul>
            </div>
          {% else %}
            <a href="{{ url_for('auth.login') }}" class="hdr-link">
              <i class="bi bi-person-circle fs-5 d-block"></i>Sign in
            </a>
          {% endif %}

          <a href="{{ url_for('cart.view_cart') }}" class="cart-pill">
            <i class="bi bi-cart3"></i>
            <span class="badge-count" data-cart-count="{{ cart_count }}"
                  {% if not cart_count %}style="display:none"{% endif %}>{{ cart_count }}</span>
            <span class="d-none d-lg-inline ms-1">Cart</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ── category nav ──────────────────────────────────────────── -->
<nav class="catnav">
  <div class="container catnav-scroll d-flex">
    <a class="nav-link {{ 'active' if request.endpoint == 'main.home' }}" href="{{ url_for('main.home') }}">All</a>
    {% for c in nav_categories %}
      <a class="nav-link {{ 'active' if request.args.get('cat') == c.slug }}" href="{{ url_for('main.products', cat=c.slug) }}">{{ c.icon }} {{ c.name }}</a>
    {% endfor %}
    <a class="nav-link" href="{{ url_for('orders.track') }}">📦 Track Order</a>
    <a class="nav-link ms-auto text-warning fw-bold" href="{{ url_for('main.products') }}">🎉 Today's Deals</a>
  </div>
</nav>

<!-- ── flash messages ────────────────────────────────────────── -->
<div class="container mt-3">
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      {% for category, msg in messages %}
        <div class="alert alert-{{ 'danger' if category == 'error' else category }} alert-dismissible fade show alert-auto py-2" role="alert">
          {{ msg }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}
    {% endif %}
  {% endwith %}
</div>

<!-- ── page content ──────────────────────────────────────────── -->
<main>
  {% block content %}{% endblock %}
</main>

<!-- ── become a seller strip ──────────────────────────────────── -->
<div class="seller-strip">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
      <span class="ss-ico">🏪</span>
      <div>
        <div class="ss-title">Become a Seller</div>
        <div class="ss-sub">Grow your business with {{ STORE_NAME }} — reach lakhs of happy customers</div>
      </div>
    </div>
    <a href="{{ url_for('auth.signup') }}" class="btn btn-warn fw-bold px-4">Register your store →</a>
  </div>
</div>

<!-- ── footer ────────────────────────────────────────────────── -->
<footer class="sk-footer pt-5 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-6 col-lg-3">
        <h6>Shop</h6>
        <a href="{{ url_for('main.products') }}">All Products</a>
        <a href="{{ url_for('main.products', sort='new') }}">New Arrivals</a>
        <a href="{{ url_for('main.products', sort='rate') }}">Top Rated</a>
        <a href="{{ url_for('main.products', max=499) }}">Under ₹499</a>
      </div>
      <div class="col-6 col-lg-3">
        <h6>Your Account</h6>
        <a href="{{ url_for('auth.account') }}">My Account</a>
        <a href="{{ url_for('orders.history') }}">Order History</a>
        <a href="{{ url_for('orders.track') }}">Track Order</a>
        <a href="{{ url_for('main.wishlist') }}">Wishlist</a>
      </div>
      <div class="col-6 col-lg-3">
        <h6>Help</h6>
        <a href="#">Returns &amp; Refunds</a>
        <a href="#">Shipping Policy</a>
        <a href="#">Contact Us</a>
        <a href="#">Grievance Officer</a>
      </div>
      <div class="col-6 col-lg-3">
        <h6>Policies</h6>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Use</a>
        <a href="#">GST &amp; Invoices</a>
        <a href="#">Cancellation Policy</a>
      </div>
    </div>
  </div>
  <div class="sk-footer-bottom text-center mt-4 py-3">
    <strong class="text-white">{{ STORE_NAME }}</strong> © {{ now.year }} — Flask + MySQL demo project.
    Cash on Delivery enabled · Payment gateway coming in Phase 9.
  </div>
</footer>

<!-- Bootstrap JS (dropdown, modal, alert) — CDN -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ url_for('static', filename='js/sk.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>