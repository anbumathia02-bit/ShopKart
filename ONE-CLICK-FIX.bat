REM ---------- 4) decode + extract ----------
echo  [2/5] Files-ah extract panren...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=[IO.File]::ReadAllText('%B64%') -replace '[^A-Za-z0-9+/=]',''; [IO.File]::WriteAllBytes('%ZIP%', [Convert]::FromBase64String($b)); Write-Host ('      decoded: ' + (Get-Item '%ZIP%').Length + ' bytes')"
set "ZSIZE=0"
for %%A in ("%ZIP%") do set "ZSIZE=%%~zA"
if not "%ZSIZE%"=="683491" (
    echo  [i] Decoded size: %ZSIZE% bytes  ^(expected 683491^)
)

if not exist "%ZIP%" (
    echo  [X] Decode problem! Marupadi intha file-ah double-click pannunga.
    echo.
    pause
    exit /b 1
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "Expand-Archive -LiteralPath '%ZIP%' -DestinationPath '%~dp0' -Force"
