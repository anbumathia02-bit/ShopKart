for %%A in ("static\css\sk.css") do set "SKCSIZE=%%~zA"
set "SKJSIZE=0"
for %%A in ("static\js\sk.js") do set "SKJSIZE=%%~zA"
set /a JPGCOUNT=0
for %%F in ("static\uploads\products\*.jpg") do set /a JPGCOUNT+=1
set "JPGSIZE=0"
for %%F in ("static\uploads\products\*.jpg") do set /a JPGSIZE+=%%~zF

echo      templates\base.html      : %BHSIZE% bytes
echo      static\css\sk.css        : %SKCSIZE% bytes
echo      static\js\sk.js          : %SKJSIZE% bytes
echo      static\uploads\products  : %JPGCOUNT% jpg files ^(%JPGSIZE% bytes total^)
