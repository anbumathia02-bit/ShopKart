@echo off
chcp 65001 >nul
title ShopKart - FIX 404 (sk.css + sk.js)
cd /d "%~dp0"

echo ============================================================
echo    ShopKart  -  FIX 404  (sk.css + sk.js missing problem)
echo ------------------------------------------------------------
echo   Server log-la ithu vandhadhu:
echo        GET /static/css/sk.css  ->  404
echo        GET /static/js/sk.js    ->  404
echo   Adhaan page white-ah irundhadhu!
echo   Intha file andha 2 file-ah correct-ah create pannum.
echo ============================================================
echo.

REM ---------- project folder-ah thaanae thedu ----------
set "PROJ="
call :try "%~dp0"
call :try "%USERPROFILE%\Desktop\Shopkart"
call :try "%USERPROFILE%\OneDrive\Desktop\Shopkart"
call :try "%USERPROFILE%\Downloads\Shopkart"
for /d %%D in ("%USERPROFILE%\Desktop\*")          do call :try "%%~fD"
for /d %%D in ("%USERPROFILE%\OneDrive\Desktop\*") do call :try "%%~fD"
for /d %%D in ("%USERPROFILE%\Downloads\*")        do call :try "%%~fD"
goto :found

:try
if defined PROJ goto :eof
if exist "%~1\app.py" if exist "%~1\templates" set "PROJ=%~1"
goto :eof

:found
if not defined PROJ (
    echo  [X] Shopkart project folder kaanala! ^(app.py + templates irukkura folder^)
    echo      Intha file-ah Desktop-la vachu double-click pannunga.
    echo.
    pause
    exit /b 1
)
echo  [OK] Project folder: %PROJ%
echo.
cd /d "%PROJ%"

REM ---------- folders create ----------
if not exist "static" mkdir "static"
if not exist "static\css" mkdir "static\css"
if not exist "static\js" mkdir "static\js"

REM ---------- payload ezhudhu ----------
set "CB64=%TEMP%\sk_css.b64"
set "JB64=%TEMP%\sk_js.b64"
type nul>"%CB64%"
type nul>"%JB64%"

echo  [1/3] sk.css data ezhudhuren... ^(3-5 second^)
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"
echo >>"%CB64%"

echo  [2/3] sk.js data ezhudhuren...
echo >>"%JB64%"
echo >>"%JB64%"
echo >>"%JB64%"

echo         Done.
echo.

REM ---------- decode ----------
echo  [3/3] Files create panren...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=[IO.File]::ReadAllText('%CB64%') -replace '[^A-Za-z0-9+/=]',''; [IO.File]::WriteAllBytes('%PROJ%\static\css\sk.css', [Convert]::FromBase64String($b)); $c=[IO.File]::ReadAllText('%JB64%') -replace '[^A-Za-z0-9+/=]',''; [IO.File]::WriteAllBytes('%PROJ%\static\js\sk.js', [Convert]::FromBase64String($c))"
echo         Done.
echo.

REM ---------- verify ----------
set "CS=0"
for %%A in ("static\css\sk.css") do set "CS=%%~zA"
set "JSS=0"
for %%A in ("static\js\sk.js") do set "JSS=%%~zA"
set /a PC=0
for %%F in ("static\uploads\products\*.jpg") do set /a PC+=1

echo  ------------------------------------------------------------
echo    static\css\sk.css  : %CS% bytes   ^(27565 irukkanum^)
echo    static\js\sk.js    : %JSS% bytes  ^(5705 irukkanum^)
echo    product photos     : %PC% jpg
echo  ------------------------------------------------------------
echo.

if not "%CS%"=="27565" (
    echo  [X] sk.css sari illa! Marupadi intha file-ah double-click pannunga.
    echo.
    pause
    exit /b 1
)
if not "%JSS%"=="5705" (
    echo  [X] sk.js sari illa! Marupadi intha file-ah double-click pannunga.
    echo.
    pause
    exit /b 1
)

echo  ✅✅ RENDU FILE-UM PERFECT-ah CREATE AAGIDUCHU!
echo.
echo  ============================================================
echo   IPPO ENNA PANNANUM:
echo.
echo     1^) Browser-ku po ^(unga site open aagirundha^)
echo     2^) Ctrl + F5 adikkunga
echo     3^) Adhu mattum! Colour design varum! 🎉
echo.
echo   ^(Server-ah restart panna VENDAAM - ippo idhu
echo    directly file system-la irundhu load aagum^)
echo  ============================================================
echo.
if %PC% LSS 19 (
    echo  📸 NOTE: Photos %PC% mattum dhaan irukku ^(19 venum^).
    echo     Real product photos venum-na: ONE-CLICK-FIX.bat
    echo     file-ah unga project folder-la vachu double-click pannunga
    echo     ^(adhu 19 photos + full design ellame pannum^).
    echo.
)
pause
